{
  "name": "shakedown-birthday-caper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-content.mjs && node scripts/asset-intake.mjs validate && npm run pwa:check && npm test",
    "serve": "python3 -m http.server 8765",
    "test:browser": "playwright test --config=playwright.config.mjs",
    "asset:validate": "node scripts/asset-intake.mjs validate",
    "asset:batch": "node scripts/batch-intake.mjs",
    "perf:audit": "node scripts/perf-audit.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "art:acceptance": "node scripts/art-acceptance-audit.mjs",
    "pwa:inventory": "node scripts/generate-offline-assets.mjs",
    "pwa:check": "node scripts/generate-offline-assets.mjs --check",
    "pwa:audit": "node scripts/pwa-full-offline-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Dependency-free static Canvas platformer: complete installable offline PWA for modern browsers",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "pngjs": "^7.0.0"
  }
}
